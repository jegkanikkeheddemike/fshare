http://localhost:80 {
	@api {
		path /upload/*
		path /mkdir/*
		path /delete/*
		path /rename/*
		path /access_key/*
		path /thumbnail/*
		path /file/*
		path /dir/*
	}

	handle @api {
		reverse_proxy api:9300 {
			lb_try_duration 10s
		}
	}

	handle {
		reverse_proxy web:5173 {
			lb_try_duration 10s
		}
	}
}
